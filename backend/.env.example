# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/mediconsult

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_IN=7

# Stripe Payment Gateway
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
STRIPE_URGENT_CONSULTATION_PRICE=4999

# Jitsi Meet
JITSI_DOMAIN=meet.jit.si
JITSI_APP_ID=your_jitsi_app_id
JITSI_APP_SECRET=your_jitsi_app_secret
JITSI_USE_JWT=false

# Urgent consultation settings (amount in smallest currency unit, e.g. cents/paise)
URGENT_CONSULTATION_FEE=4999
CURRENCY=inr
