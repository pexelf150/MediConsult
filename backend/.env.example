# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/mediconsult

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_IN=7

# Stripe Payment Gateway
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
STRIPE_URGENT_CONSULTATION_PRICE=4999

# Zoom Video Conferencing
ZOOM_API_KEY=your_zoom_api_key
ZOOM_API_SECRET=your_zoom_api_secret
ZOOM_USER_ID=your_zoom_user_id
ZOOM_MEETING_TYPE=2

# Urgent consultation settings (amount in smallest currency unit, e.g. cents/paise)
URGENT_CONSULTATION_FEE=4999
CURRENCY=inr
